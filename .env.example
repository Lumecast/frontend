# Lumecast frontend environment. Copy to `.env` and adjust per environment.

# Base URL for lumecast/indexer-api (read path: markets, history, positions).
VITE_INDEXER_API_URL=http://localhost:8080

# Soroban RPC endpoint (testnet or mainnet) — used for writes.
VITE_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Deployed address of the market contract.
VITE_MARKET_CONTRACT_ID=

# USDC Stellar Asset Contract address on the target network.
VITE_USDC_CONTRACT_ID=

# Network passphrase (testnet/mainnet).
VITE_NETWORK_PASSPHRASE=Test SDF Network ; September 2015